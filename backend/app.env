# environment
ENVIRONMENT=development
ENABLE_TLS=
TLS_CERT=
TLS_KEY=

# db 
DB_DRIVER=postgres
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sso_dashboard
DB_PORT=5432
DB_ENABLE_SSL=false

# keycloak
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_SECRET=
KEYCLOAK_TOKEN=

# jwt
TOKEN_SYMMETRIC_KEY=supersecretkey123456789
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=720h

# app
SERVER_PORT=9000
GIN_MODE=debug