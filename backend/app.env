# environment
ENVIRONMENT=development
ENABLE_TLS=true
TLS_CERT=/app/certs/server.crt
TLS_KEY=/app/certs/server.key
TLS_KEYCLOAK_CA_CERT_PATH=/usr/local/share/ca-certificates/keycloak.crt

# db 
DB_DRIVER=postgres
DB_HOST=backend-db
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sso_dashboard
DB_PORT=5432
DB_ENABLE_SSL=false

# keycloak
KEYCLOAK_BASE_URL=http://localhost:8081
KEYCLOAK_REALM=moh-realm
KEYCLOAK_CLIENT_ID=dashboard
KEYCLOAK_SECRET=U2FsdGVkX19T2cV2PfUkkEIwdGnJICQXma6zEe+yTig=
KEYCLOAK_REDIRECT_URI=http://localhost:9000/api/v1/auth/callback

# jwt
TOKEN_SYMMETRIC_KEY=supersecretkey123456789
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=720h

# redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=


# app
SERVER_PORT=9000
GIN_MODE=debug
