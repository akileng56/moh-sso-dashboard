# Deployment & CORS
ENVIRONMENT=development
ALLOWED_DOMAINS=

# Throttling
RATE_LIMIT=
RATE_BURST=

# ssl certificates
ENABLE_TLS=
TLS_CERT=
TLS_KEY=

# db 
DB_DRIVER=postgres
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=
DB_ENABLE_SSL=

# keycloak
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_SECRET=
KEYCLOAK_TOKEN=
# ==================================================
# Global
# ==================================================
ENVIRONMENT=development
GIN_MODE=debug

# ==================================================
# Keycloak (Infrastructure)
# ==================================================
KEYCLOAK_VERSION=26.0.5

KEYCLOAK_DB=postgres
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Used by Keycloak container itself
KEYCLOAK_HOSTNAME=http://localhost:8081

# ==================================================
# Keycloak (Application / Backend usage)
# ==================================================
KEYCLOAK_REALM=moh-realm
KEYCLOAK_CLIENT_ID=dashboard
KEYCLOAK_CLIENT_SECRET=U2FsdGVkX19T2cV2PfUkkEIwdGnJICQXma6zEe+yTig=
KEYCLOAK_REDIRECT_URI=http://localhost:9000/api/v1/auth/callback

# ==================================================
# Backend (Go / Gin)
# ==================================================
BACKEND_PORT=9000

# ==================================================
# Backend Database
# ==================================================
DB_DRIVER=postgres
DB_HOST=backend-db
DB_PORT=5432
DB_NAME=sso_dashboard
DB_USER=postgres
DB_PASSWORD=postgres
DB_ENABLE_SSL=false

# Aliases expected by docker-compose
BACKEND_DB_NAME=sso_dashboard
BACKEND_DB_USER=postgres
BACKEND_DB_PASSWORD=postgres

# ==================================================
# Redis
# ==================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================================================
# JWT / Auth
# ==================================================
TOKEN_SYMMETRIC_KEY=supersecretkey12345678901234567890
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=720h

# ==================================================
# TLS (Disabled for Development)
# ==================================================
ENABLE_TLS=false
TLS_CERT=/app/certs/server.crt
TLS_KEY=/app/certs/server.key
TLS_KEYCLOAK_CA_CERT_PATH=/usr/local/share/ca-certificates/keycloak.crt

# jwt
TOKEN_SYMMETRIC_KEY=
ACCESS_TOKEN_DURATION=
REFRESH_TOKEN_DURATION=