{
  "id": "moh-realm",
  "realm": "moh-realm",
  "enabled": true,
  "clients": [
    {
      "id": "dashboard",
      "clientId": "dashboard",
      "name": "MOH SSO Dashboard",
      "rootUrl": "http://localhost:3000",
      "adminUrl": "http://localhost:3000",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["+"],
      "publicClient": false,
      "secret": "changeme",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role with full access"
      },
      {
        "name": "user",
        "description": "Standard user role"
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "System",
      "lastName": "Admin",
      "email": "admin@moh.go.ug",
      "credentials": [
        {
          "type": "password",
          "value": "Admin@123",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "email": "user@moh.go.ug",
      "credentials": [
        {
          "type": "password",
          "value": "User@123",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    }
  ]
}
