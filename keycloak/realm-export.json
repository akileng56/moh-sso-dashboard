{
  "id": "moh-realm",
  "realm": "moh-realm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,

  "clients": [
    {
      "id": "dashboard",
      "clientId": "dashboard",
      "name": "MOH SSO Dashboard",
      "description": "Frontend dashboard client for MOH applications",
      "rootUrl": "http://localhost:3000",
      "adminUrl": "http://localhost:3000",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:9000/api/v1/auth/callback",
        "http://localhost:3000/dashboard"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:9000"
      ],
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "U2FsdGVkX19T2cV2PfUkkEIwdGnJICQXma6zEe+yTig=",
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "icon": "settings",
        "baseUrl": "http://localhost:3000",
        "access.token.lifespan": "1800",
        "refresh.token.lifespan": "3600",
        "use.refresh.tokens": "true",
        "refresh.token.max.reuse": "0",
        "pkce.code.challenge.method": "",
        "oauth2.device.authorization.grant.enabled": "false"
      }
    },

    {
      "id": "moh-reports",
      "clientId": "moh-reports",
      "name": "MOH Reports Portal",
      "description": "Analytics and reporting dashboard",
      "rootUrl": "http://localhost:4001",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:4001/*"],
      "webOrigins": ["http://localhost:4001"],
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "attributes": {
        "icon": "document",
        "baseUrl": "http://localhost:4001"
      }
    },

    {
      "id": "hmis-web",
      "clientId": "hmis-web",
      "name": "HMIS Web Portal",
      "description": "Health Management Information System Web",
      "rootUrl": "http://localhost:4002",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:4002/*"],
      "webOrigins": ["http://localhost:4002"],
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "attributes": {
        "icon": "calendar",
        "baseUrl": "http://localhost:4002"
      }
    },

    {
      "id": "obulamu-web",
      "clientId": "obulamu-web",
      "name": "ObulamuCare Web Portal",
      "description": "Community support platform",
      "rootUrl": "http://localhost:4003",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:4003/*"],
      "webOrigins": ["http://localhost:4003"],
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "attributes": {
        "icon": "email",
        "baseUrl": "http://localhost:4003"
      }
    },

    {
      "id": "prisons-emr",
      "clientId": "prisons-emr",
      "name": "Prisons EMR",
      "description": "Electronic Medical Records for Prisons",
      "rootUrl": "http://localhost:4004",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:4004/*"],
      "webOrigins": ["http://localhost:4004"],
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "attributes": {
        "icon": "user",
        "baseUrl": "http://localhost:4004"
      }
    }
  ],

  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role with full access"
      },
      {
        "name": "manager",
        "description": "Can manage some applications"
      },
      {
        "name": "user",
        "description": "Standard user role"
      }
    ],
    "client": {
      "dashboard": [
        { "name": "dashboard_access", "description": "Access MOH Dashboard" }
      ],
      "moh-reports": [
        { "name": "reports_access", "description": "Access MOH Reports Portal" }
      ],
      "hmis-web": [
        { "name": "hmis_access", "description": "Access HMIS Web Portal" }
      ],
      "obulamu-web": [
        { "name": "obulamu_access", "description": "Access ObulamuCare Web Portal" }
      ],
      "prisons-emr": [
        { "name": "prisons_access", "description": "Access Prisons EMR" }
      ]
    }
  },

